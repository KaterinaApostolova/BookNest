@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<BookNest.Models.Forum>

@{
    ViewData["Title"] = Localizer["Community"];
}

<div class="d-flex justify-content-between align-items-start mb-2 gap-3 flex-wrap">
    <div>
        <h1 class="h3 mb-1">@Localizer["Community"]</h1>
        <p class="text-muted mb-0">@Localizer["Choose a forum to join the conversation."]</p>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary" asp-controller="Community" asp-action="CreateForum">@Localizer["Add forum"]</a>
    }
    else
    {
        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">@Localizer["Log in to add a forum"]</a>
    }
</div>

<hr class="my-4" />

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">@Localizer["There are no forums yet. Start the first one."]</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Community" asp-action="CreateForum">@Localizer["Add forum"]</a>
        }
        else
        {
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">@Localizer["Log in to add a forum"]</a>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var forum in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="forum-card">
                    <div class="forum-card-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <h2 class="h5 mb-2">@forum.Name</h2>
                    <p class="text-muted mb-3 flex-grow-1">@(forum.Description ?? Localizer["Join other readers in this forum."].Value)</p>

                    <div class="forum-meta mb-3">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        <span>@forum.Topics.Count @Localizer["topic(s),"] @forum.Topics.Sum(t => t.Posts.Count) @(forum.Topics.Sum(t => t.Posts.Count) == 1 ? Localizer["reply"] : Localizer["replies"])</span>
                    </div>

                    @if (forum.Topics.Any())
                    {
                        var latestTopic = forum.Topics.OrderByDescending(t => t.CreatedAt).First();
                        <div class="small mb-3 pb-3 border-bottom">
                            <span class="text-muted">@Localizer["Latest:"]</span> <span class="fw-semibold">@latestTopic.Title</span>
                            <div class="text-muted">@latestTopic.CreatedAt.ToLocalTime().ToString("d")</div>
                        </div>
                    }

                    <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Community" asp-action="Forum" asp-route-id="@forum.Id">@Localizer["Open forum"]</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-controller="Community" asp-action="DeleteForum" asp-route-id="@forum.Id" method="post" onsubmit="return confirm('@Localizer["Delete this forum and all its topics and replies?"]');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Delete"]</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
