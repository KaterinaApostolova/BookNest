@model BookNest.ViewModels.ForumTopicViewModel

@{
    ViewData["Title"] = "Edit Topic";
}

<h2 class="mb-1">Edit topic</h2>
<p class="text-muted mb-4">In @Model.ForumName</p>

<form asp-controller="Community" asp-action="EditTopic" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
    @Html.AntiForgeryToken()
        <input asp-for="ForumId" type="hidden" />
        <input asp-for="ForumName" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Topic title</label>
            <input asp-for="Title" class="form-control" maxlength="150" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Content" class="form-label">Topic content</label>
            <textarea asp-for="Content" class="form-control" rows="6" maxlength="4000"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Topic" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
