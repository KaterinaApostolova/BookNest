@model BookNest.ViewModels.ForumViewModel

@{
    ViewData["Title"] = "Add Forum";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Add forum</h2>
    <a asp-controller="Community" asp-action="Index" class="btn btn-outline-secondary">Back to community</a>
</div>

<form asp-controller="Community" asp-action="CreateForum" method="post" class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
    @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Forum name</label>
            <input asp-for="Name" class="form-control" maxlength="100" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Description" class="form-label">Description <span class="text-muted">(optional)</span></label>
            <textarea asp-for="Description" class="form-control" rows="4" maxlength="500"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Create forum</button>
        <a asp-controller="Community" asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}