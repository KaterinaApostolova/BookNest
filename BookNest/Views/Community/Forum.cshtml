@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.ViewModels.ForumPageViewModel
@{
    ViewData["Title"] = Model.Forum.Name;
    var postCounts = ViewBag.PostCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var topicReactions = ViewBag.TopicReactions as Dictionary<int, BookNest.ViewModels.ReactionSummary> ?? new Dictionary<int, BookNest.ViewModels.ReactionSummary>();
}

<nav class="forum-breadcrumb">
    <a asp-controller="Community" asp-action="Index">@Localizer["Community"]</a>
    <span> / </span>
    <span>@Model.Forum.Name</span>
</nav>

<div class="d-flex justify-content-between align-items-start gap-3 mb-2 flex-wrap">
    <div>
        <h1 class="h3 mb-2">@Model.Forum.Name</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Forum.Description))
        {
            <p class="text-muted mb-1">@Model.Forum.Description</p>
        }
        @if (Model.Forum.Book is not null)
        {
            <p class="small text-muted mb-0">@Localizer["Book discussion for"] <span class="fw-semibold">@Model.Forum.Book.Title</span></p>
        }
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary" asp-controller="Community" asp-action="CreateTopic" asp-route-forumId="@Model.Forum.Id">@Localizer["Add topic"]</a>
    }
    else
    {
        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">@Localizer["Log in to add a topic"]</a>
    }
</div>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="small text-muted mb-0">@Localizer["Sort by"]</label>
        <select name="sort" class="form-select form-select-sm sort-select" onchange="this.form.submit()">
            <option value="newest" selected="@(Model.Sort == "newest")">@Localizer["Newest"]</option>
            <option value="active" selected="@(Model.Sort == "active")">@Localizer["Most Active"]</option>
            <option value="replies" selected="@(Model.Sort == "replies")">@Localizer["Most Replies"]</option>
        </select>
    </form>
</div>

<hr class="my-3" />

@if (!Model.Topics.Any())
{
    <div class="text-center py-5">
        <h2 class="h5">@Localizer["No topics yet"]</h2>
        <p class="text-muted mb-0">@Localizer["Start the conversation in this forum."]</p>
    </div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var topic in Model.Topics)
        {
            var reaction = topicReactions.TryGetValue(topic.Id, out var r) ? r : new BookNest.ViewModels.ReactionSummary();
            var postCount = topic.UserId != null && postCounts.TryGetValue(topic.UserId, out var pc) ? pc : 0;

            <div class="topic-row">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            @if (topic.IsPinned)
                            {
                                <span class="badge topic-badge-pin">📌 @Localizer["Pinned"]</span>
                            }
                            @if (topic.IsLocked)
                            {
                                <span class="badge topic-badge-lock">🔒 @Localizer["Locked"]</span>
                            }
                        </div>
                        <a class="text-decoration-none text-dark" asp-controller="Community" asp-action="Topic" asp-route-id="@topic.Id">
                            <h3 class="h6 mb-1">@topic.Title</h3>
                        </a>
                        <div class="small text-muted mb-1">
                            @Localizer["Started by"]
                            @(topic.IsAnonymous ? Localizer["Anonymous"].Value : (topic.User != null ? topic.User.UserName : Localizer["BookNest member"].Value))
                            &middot; @topic.CreatedAt.ToLocalTime().ToString("d")
                        </div>
                        <div class="small text-muted">
                            👁 @topic.ViewCount @Localizer["views"]
                            &middot; 👍 @reaction.Likes &middot; 👎 @reaction.Dislikes
                        </div>
                    </div>
                    <span class="topic-reply-count">@topic.Posts.Count @Localizer["reply(s)"]</span>
                </div>

                <div class="mt-3 d-flex gap-2 flex-wrap">
                    @if (topic.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Community" asp-action="EditTopic" asp-route-id="@topic.Id">@Localizer["Edit"]</a>
                        <form asp-controller="Community" asp-action="DeleteTopic" asp-route-id="@topic.Id" method="post" onsubmit="return confirm('@Localizer["Delete this topic and its replies?"]');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Delete"]</button>
                        </form>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        @if (topic.UserId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <form asp-controller="Community" asp-action="DeleteTopic" asp-route-id="@topic.Id" method="post" onsubmit="return confirm('@Localizer["Delete this topic and its replies?"]');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Delete topic"]</button>
                            </form>
                        }
                        <form asp-controller="Community" asp-action="TogglePinTopic" asp-route-id="@topic.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@(topic.IsPinned ? Localizer["Unpin"] : Localizer["Pin"])</button>
                        </form>
                        <form asp-controller="Community" asp-action="ToggleLockTopic" asp-route-id="@topic.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@(topic.IsLocked ? Localizer["Unlock"] : Localizer["Lock"])</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination-bar">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <a class="btn btn-sm @(p == Model.Page ? "btn-primary" : "btn-outline-secondary")"
                   asp-controller="Community" asp-action="Forum" asp-route-id="@Model.Forum.Id" asp-route-sort="@Model.Sort" asp-route-page="@p">@p</a>
            }
        </div>
    }
}
