@model BookNest.Models.Forum

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h2 class="mb-2">@Model.Name</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted mb-0">@Model.Description</p>
        }
        @if (Model.Book is not null)
        {
            <p class="small text-muted mb-0">Book discussion for <span class="fw-semibold">@Model.Book.Title</span></p>
        }
    </div>
    <div class="d-flex flex-wrap justify-content-end gap-2">
        <a asp-controller="Community" asp-action="Index" class="btn btn-outline-secondary">Back to community</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Community" asp-action="CreateTopic" asp-route-forumId="@Model.Id">Add topic</a>
        }
    </div>
</div>

@if (!Model.Topics.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 text-center">
            <h3 class="h5">No topics yet</h3>
            <p class="text-muted mb-0">Start the conversation in this forum.</p>
        </div>
    </div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var topic in Model.Topics.OrderByDescending(t => t.CreatedAt))
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <a class="text-decoration-none" asp-controller="Community" asp-action="Topic" asp-route-id="@topic.Id">
                            <h3 class="h5 mb-1">@topic.Title</h3>
                        </a>
                        <span class="small text-muted text-nowrap">@topic.Posts.Count reply(s)</span>
                    </div>
                    <small class="text-muted">Started by @(topic.User?.UserName ?? "BookNest member") on @topic.CreatedAt.ToLocalTime().ToString("d")</small>
                    @if (topic.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <div class="mt-3 d-flex gap-2">
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Community" asp-action="EditTopic" asp-route-id="@topic.Id">Edit</a>
                            <form asp-controller="Community" asp-action="DeleteTopic" asp-route-id="@topic.Id" method="post" onsubmit="return confirm('Delete this topic and its replies?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    }
                    @if (User.IsInRole("Admin") && topic.UserId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <div class="mt-3">
                            <form asp-controller="Community" asp-action="DeleteTopic" asp-route-id="@topic.Id" method="post" onsubmit="return confirm('Delete this topic and its replies?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete topic</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}