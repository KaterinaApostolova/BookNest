@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = Localizer["My Profile"];
}

<div class="container mt-5 mb-5">

    <!-- PROFILE HERO -->
    <div class="profile-hero mb-4">
        <div class="row align-items-center g-4">
            <div class="col-auto">
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="Profile picture" class="profile-hero-avatar" />
                }
                else
                {
                    <div class="profile-hero-avatar-fallback">@Model.AvatarInitials</div>
                }
            </div>
            <div class="col">
                <h1 class="profile-hero-name h3 mb-1">@Model.UserName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.FullName))
                {
                    <p class="profile-hero-meta mb-1">@Model.FullName</p>
                }
                <p class="profile-hero-meta small mb-0">@Localizer["Member since"] @Model.MemberSince.ToLocalTime().ToString("dd.MM.yyyy")</p>
            </div>
            <div class="col-12 col-lg-auto d-flex gap-2 flex-wrap">
                <a asp-controller="Profile" asp-action="Edit" class="btn btn-light">@Localizer["Edit Profile"]</a>
                <a asp-controller="Profile" asp-action="MyPublicProfile" class="btn btn-outline-light">@Localizer["View Public Profile"]</a>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- ABOUT / DETAILS SIDEBAR -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <div class="section-label mb-3">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    @Localizer["About"]
                </div>

                <div class="small fw-semibold mb-1">@Localizer["Email"]</div>
                <div class="small text-break mb-3">@Model.Email</div>

                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <p class="mb-3 small">@Model.Bio</p>
                }
                else
                {
                    <p class="text-muted mb-3 small fst-italic">@Localizer["You haven't added a bio yet."]</p>
                }

                <div class="d-flex flex-column gap-3">
                    <div>
                        <div class="small text-muted mb-1">@Localizer["Favourite Genre"]</div>
                        @if (!string.IsNullOrWhiteSpace(Model.FavouriteGenre))
                        {
                            <span class="badge bg-primary">@Model.FavouriteGenre</span>
                        }
                        else
                        {
                            <span class="text-muted small">@Localizer["No favourite genre selected."]</span>
                        }
                    </div>
                    <div>
                        <div class="small text-muted mb-1">@Localizer["Favourite Book"]</div>
                        @if (!string.IsNullOrWhiteSpace(Model.FavouriteBookTitle))
                        {
                            <span class="badge bg-primary">@Model.FavouriteBookTitle</span>
                        }
                        else
                        {
                            <span class="text-muted small">@Localizer["No favourite book selected."]</span>
                        }
                    </div>
                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="col-lg-8">

            <!-- READING STATISTICS -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="section-label mb-3">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/></svg>
                    @Localizer["Reading Statistics"]
                </div>
                <div class="stat-strip">
                    <div class="stat-strip-item">
                        <div class="stat-strip-value">@Model.BooksRead</div>
                        <div class="stat-strip-label">@Localizer["Books Read"]</div>
                    </div>
                    <div class="stat-strip-item">
                        <div class="stat-strip-value">@Model.CurrentlyReading</div>
                        <div class="stat-strip-label">@Localizer["Currently Reading"]</div>
                    </div>
                    <div class="stat-strip-item">
                        <div class="stat-strip-value">@Model.WantToRead</div>
                        <div class="stat-strip-label">@Localizer["Want to Read"]</div>
                    </div>
                    <div class="stat-strip-item">
                        <div class="stat-strip-value">@Model.ReviewsWritten</div>
                        <div class="stat-strip-label">@Localizer["Reviews"]</div>
                    </div>
                </div>
            </div>


            <!-- COMMUNITY STATISTICS -->
            <div class="card border-0 shadow-sm rounded-4 p-4">

                <div class="d-flex justify-content-between align-items-start mb-3 gap-3">
                    <div class="section-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        @Localizer["Community Statistics"]
                    </div>
                    <a asp-controller="Community" asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Visit Community"]</a>
                </div>

                <div class="stat-strip">
                    <div class="stat-strip-item">
                        <div class="stat-strip-value">@Model.ForumsStarted</div>
                        <div class="stat-strip-label">@Localizer["Forums Started"]</div>
                    </div>
                    <div class="stat-strip-item">
                        <div class="stat-strip-value">@Model.TopicsStarted</div>
                        <div class="stat-strip-label">@Localizer["Topics Started"]</div>
                    </div>
                    <div class="stat-strip-item">
                        <div class="stat-strip-value">@Model.RepliesWritten</div>
                        <div class="stat-strip-label">@Localizer["Replies Written"]</div>
                    </div>
                </div>

            </div>

            <!-- FAVOURITE QUOTE -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="section-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
                        @Localizer["Favourite Quote"]
                    </div>
                    <a asp-controller="Profile" asp-action="Edit" class="btn btn-outline-primary btn-sm">
                        @(string.IsNullOrWhiteSpace(Model.FavouriteQuote) ? Localizer["Add Quote"] : Localizer["Edit Quote"])
                    </a>
                </div>
                @if (string.IsNullOrWhiteSpace(Model.FavouriteQuote))
                {
                    <div class="bg-light rounded-4 p-4 mt-4 text-center">
                        <p class="text-muted mb-3">@Localizer["Add your favourite quote"]</p>
                        <a asp-controller="Profile" asp-action="Edit" class="btn btn-primary btn-sm">@Localizer["Add Quote"]</a>
                    </div>
                }
                else
                {
                    <blockquote class="border-start border-primary border-3 ps-3 mt-4 mb-0">
                        <p class="mb-3" style="white-space: pre-wrap">@Model.FavouriteQuote</p>
                        <div class="d-flex gap-2">
                            <a asp-controller="Profile" asp-action="Edit" class="btn btn-outline-secondary btn-sm">@Localizer["Update"]</a>
                            <form asp-controller="Profile" asp-action="RemoveFavouriteQuote" method="post" onsubmit="return confirm('@Localizer["Remove your favourite quote?"]');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Remove"]</button>
                            </form>
                        </div>
                    </blockquote>
                }
            </div>
        </div>
    </div>



    <!-- MY REVIEWS -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">

        <div class="d-flex justify-content-between
                    align-items-center mb-4">

            <div>

                <h2 class="h5 mb-1">
                    @Localizer["My Reviews"]
                </h2>

                <p class="text-muted small mb-0">
                    @Localizer["Reviews you have written for books."]
                </p>

            </div>

            <span class="badge bg-light text-dark">
                @Model.ReviewsWritten
            </span>

        </div>


        @if (Model.Reviews.Any())
        {
            <div class="d-flex flex-column gap-3">

                @foreach (var review in Model.Reviews)
                {
                    <div class="border rounded-4 p-3">

                        <!-- Review Header -->
                        <div class="d-flex justify-content-between
                                    align-items-start gap-3">

                            <div>

                                <a asp-controller="Books"
                                   asp-action="Details"
                                   asp-route-id="@review.BookId"
                                   class="text-decoration-none fw-semibold">

                                    @review.BookTitle

                                </a>

                            </div>

                            <div class="small text-muted text-nowrap">

                                @review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")

                            </div>

                        </div>


                        <!-- Rating -->
                        <div class="mt-2">

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <span class="rating-star filled"
                                          title="@i out of 5">
                                        &#9733;
                                    </span>
                                }
                                else
                                {
                                    <span class="rating-star empty"
                                          title="@i out of 5">
                                        &#9733;
                                    </span>
                                }
                            }

                        </div>


                        <!-- Review Text -->
                        <p class="mt-2 mb-3">
                            @review.Content
                        </p>


                        <!-- Actions -->
                        <div class="d-flex gap-2 flex-wrap">

                            <a asp-controller="Books"
                               asp-action="Details"
                               asp-route-id="@review.BookId"
                               class="btn btn-sm btn-outline-secondary">

                                @Localizer["View Book"]

                            </a>

                            <a asp-controller="Reviews"
                               asp-action="Edit"
                               asp-route-id="@review.Id"
                               class="btn btn-sm btn-outline-primary">

                                @Localizer["Edit"]

                            </a>

                            <form asp-controller="Reviews"
                                  asp-action="Delete"
                                  asp-route-id="@review.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('@Localizer["Are you sure you want to delete this review?"]');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">

                                    @Localizer["Delete"]

                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-center py-4">

                <p class="text-muted mb-3">
                    @Localizer["You haven't written any reviews yet."]
                </p>

                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn btn-outline-primary">

                    @Localizer["Browse Books"]

                </a>

            </div>
        }

    </div>


    <!-- MY CONTRIBUTIONS -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <div>

                <h2 class="h5 mb-1">
                    @Localizer["My Contributions"]
                </h2>

                <p class="text-muted small mb-0">
                    @Localizer["Suggestions and contributions you have submitted."]
                </p>

            </div>

            <a asp-controller="ContributionRequests"
               asp-action="MyRequests"
               class="btn btn-outline-secondary btn-sm">

                @Localizer["View All"]

            </a>

        </div>


        @if (Model.ContributionRequests != null &&
             Model.ContributionRequests.Any())
        {
            <div class="list-group list-group-flush">

                @foreach (var request in Model.ContributionRequests.Take(5))
                {
                    <div class="list-group-item px-0 py-3">

                        <div class="d-flex justify-content-between
                                    align-items-start gap-3">

                            <div>

                                <div class="fw-semibold">
                                    @request.DisplayType
                                </div>


                                @if (!string.IsNullOrWhiteSpace(request.BookTitle))
                                {
                                    <div class="small text-muted">
                                        @request.BookTitle
                                    </div>
                                }


                                <div class="small text-muted mt-1">
                                    @request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                </div>

                            </div>


                            <div>

                                @if (request.Status == ContributionRequestStatuses.Pending)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @Localizer["Pending"]
                                    </span>
                                }
                                else if (request.Status == ContributionRequestStatuses.Approved)
                                {
                                    <span class="badge bg-success">
                                        @Localizer["Approved"]
                                    </span>
                                }
                                else if (request.Status == ContributionRequestStatuses.Rejected)
                                {
                                    <span class="badge bg-danger">
                                        @Localizer["Rejected"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @Localizer["Resolved"]
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="mt-2">

                            <a asp-controller="ContributionRequests"
                               asp-action="Details"
                               asp-route-id="@request.Id"
                               class="btn btn-outline-primary btn-sm">

                                @Localizer["View Request"]

                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <p class="text-muted mb-3">
                @Localizer["You haven't submitted any contribution requests yet."]
            </p>

            <a asp-controller="ContributionRequests"
               asp-action="MakeSuggestion"
               class="btn btn-outline-primary">

                @Localizer["Make Your First Suggestion"]

            </a>
        }

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
