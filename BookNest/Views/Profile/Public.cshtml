@model BookNest.ViewModels.PublicProfileViewModel

@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <!-- Profile Header -->

                <div class="d-flex align-items-center gap-3">

                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl"
                             alt="Profile picture"
                             class="rounded-circle"
                             style="width: 90px; height: 90px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary text-white
                                    d-flex align-items-center justify-content-center"
                             style="width: 90px; height: 90px; font-size: 28px;">
                            @Model.AvatarInitials
                        </div>
                    }


                    <div>

                        <h1 class="h3 mb-1">
                            @Model.DisplayName
                        </h1>

                        @if (!string.IsNullOrWhiteSpace(Model.FullName))
                        {
                            <div class="text-muted">
                                @Model.FullName
                            </div>
                        }

                        <small class="text-muted">
                            Member since 
                            @Model.MemberSince.ToLocalTime().ToString("dd.MM.yyyy")
                        </small>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Bio -->

                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <div class="mb-4">

                        <h2 class="h6">
                            About
                        </h2>
                         
                         <div class="small text-muted mb-1">
                                 Bio
                         </div>

                        <p class="text-muted mb-0">
                            @Model.Bio
                        </p>

                    </div>
                }
                 <!-- Favourite Genre -->

               <div class="mt-3">

                  <div class="small text-muted mb-1">
                      Favourite Genre
                  </div>

                  @if (!string.IsNullOrWhiteSpace(Model.FavouriteGenre))
                  {
                      <span class="badge bg-primary">
                          @Model.FavouriteGenre
                      </span>
                  }
                  else
                  {
                      <span class="text-muted small">
                         No favourite genre selected.
                     </span>
                  }

               </div>

                 <!-- Favourite Book -->

               <div class="mt-3">

                  <div class="small text-muted mb-1">
                     Favourite Book
                  </div>

                  @if (!string.IsNullOrWhiteSpace(Model.FavouriteBook))
                  {
                      <span class="fw-semibold small">
                         @Model.FavouriteBook
                      </span>
                  }
                  else
                  {
                     <span class="text-muted small">
                        No favourite book selected.
                     </span>
                  }

               </div>

               <hr class="my-4" />

                <!-- Statistics -->

                <div class="mb-4">

                    <h2 class="h6 mb-3">
                        Reading Statistics
                    </h2>

                    <div class="row g-3">

                        <div class="col-md-4 col-6">

                            <div class="bg-light rounded-4 p-3 text-center">

                                <div class="fs-4 fw-bold">
                                    @Model.BooksRead
                                </div>

                                <div class="small text-muted">
                                    Books Read
                                </div>

                            </div>

                        </div>


                        <div class="col-md-4 col-6">

                            <div class="bg-light rounded-4 p-3 text-center">

                                <div class="fs-4 fw-bold">
                                    @Model.BooksInJourney
                                </div>

                                <div class="small text-muted">
                                    Books in Reading Journey
                                </div>

                            </div>

                        </div>


                        <div class="col-md-4 col-12">

                            <div class="bg-light rounded-4 p-3 text-center">

                                <div class="fs-4 fw-bold">
                                    @Model.ReviewsWritten
                                </div>

                                <div class="small text-muted">
                                    Reviews
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- Reviews -->

                <div>

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h2 class="h5 mb-0">
                            Reviews
                        </h2>

                    </div>


                    @if (Model.Reviews.Any())
                    {
                        <div class="d-flex flex-column gap-3">

                            @foreach (var review in Model.Reviews)
                            {
                                <div class="border rounded-4 p-3">

                                    <div class="d-flex justify-content-between">

                                        <div class="fw-semibold">
                                            @review.BookTitle
                                        </div>

                                        <div class="text-muted small">
                                            @(review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy"))
                                        </div>

                                    </div>


                                    <div class="mt-2">

                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                           if (i <= review.Rating)
                                           {
                                             <span class="rating-star filled"
                                                 title="@i out of 5">
                                                 &#9733;
                                             </span>
                                           }
                                           else
                                           {
                                              <span class="rating-star empty"
                                                  title="@i out of 5">
                                                  &#9733;
                                              </span>
                                            }
                                        }

                                    </div>


                                    <p class="mt-2 mb-0 text-muted">
                                        @review.Content
                                    </p>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            This reader hasn't written any reviews yet.
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
