@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.ViewModels.ReadingLinkViewModel

@{
    ViewData["Title"] = Localizer["Add Reading Link"];
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h2 class="h4 mb-4">@Localizer["Add Reading Link"]</h2>

        <p class="text-muted">
            @Localizer["Add a reading or purchase option for"]
            <strong>@ViewBag.BookTitle</strong>.
        </p>

        <form asp-action="AddReadingLink" method="post">
            <input asp-for="BookId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="WebsiteName" class="form-label">
                    @Localizer["Website"]
                </label>

                <input asp-for="WebsiteName"
                       class="form-control"
                       placeholder="e.g. Chitanka" />

                <span asp-validation-for="WebsiteName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Language" class="form-label">
                    @Localizer["Language"]
                </label>

                <input asp-for="Language"
                       class="form-control"
                       placeholder="e.g. Bulgarian" />

                <span asp-validation-for="Language"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Url" class="form-label">
                    @Localizer["URL"]
                </label>

                <input asp-for="Url"
                       class="form-control"
                       placeholder="https://..." />

                <span asp-validation-for="Url"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LinkType" class="form-label">
                    @Localizer["Link Type"]
                </label>

                <select asp-for="LinkType" class="form-select">
                    <option value="">@Localizer["Select type"]</option>
                    <option value="Read Online">@Localizer["Read Online"]</option>
                    <option value="Borrow">@Localizer["Borrow"]</option>
                    <option value="Buy">@Localizer["Buy"]</option>
                    <option value="Audiobook">@Localizer["Audiobook"]</option>
                </select>

                <span asp-validation-for="LinkType"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                @Localizer["Add Link"]
            </button>

            <a asp-controller="Books"
               asp-action="Details"
               asp-route-id="@Model.BookId"
               class="btn btn-secondary">
                @Localizer["Cancel"]
            </a>
        </form>
    </div>
</div>
