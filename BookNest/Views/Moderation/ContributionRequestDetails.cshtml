@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.Models.ContributionRequest

@{
    ViewData["Title"] = Localizer["Contribution Request"];
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <div class="d-flex justify-content-between align-items-start mb-4">

                    <div>
                        <h1 class="h4 mb-1">
                            @Localizer["Contribution Request"]
                        </h1>

                        <p class="text-muted mb-0">
                            @Localizer["Request #"]@Model.Id
                        </p>
                    </div>

                    @if (Model.Status == ContributionRequestStatuses.Pending)
                    {
                        <span class="badge bg-warning text-dark">
                            @Localizer["Pending"]
                        </span>
                    }
                    else if (Model.Status == ContributionRequestStatuses.Approved)
                    {
                        <span class="badge bg-success">
                            @Localizer["Approved"]
                        </span>
                    }
                    else if (Model.Status == ContributionRequestStatuses.Rejected)
                    {
                        <span class="badge bg-danger">
                            @Localizer["Rejected"]
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            @Localizer["Resolved"]
                        </span>
                    }

                </div>


                <dl class="row">

                    <dt class="col-sm-4">
                        @Localizer["User"]
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.User?.UserName ?? Localizer["Unknown"].Value)
                    </dd>


                    <dt class="col-sm-4">
                        @Localizer["Request Type"]
                    </dt>

                    <dd class="col-sm-8">

                        @switch (Model.RequestType)
                        {
                            case ContributionRequestTypes.ReadingLink:
                                <span>@Localizer["Reading Link"]</span>
                                break;

                            case ContributionRequestTypes.BookInformation:
                                <span>@Localizer["Book Information"]</span>
                                break;

                            case ContributionRequestTypes.NewBook:
                                <span>@Localizer["New Book"]</span>
                                break;

                            case ContributionRequestTypes.GeneralSuggestion:
                                <span>@Localizer["General Suggestion"]</span>
                                break;

                            case ContributionRequestTypes.AdminRequest:
                                <span>@Localizer["Moderator Request"]</span>
                                break;

                            default:
                                <span>@Model.RequestType</span>
                                break;
                        }

                    </dd>


                    <dt class="col-sm-4">
                        @Localizer["Book"]
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.Book?.Title ?? Localizer["Not related to a specific book"].Value)
                    </dd>


                    <dt class="col-sm-4">
                        @Localizer["Submitted"]
                    </dt>

                    <dd class="col-sm-8">
                        @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </dd>

                </dl>


                <hr />

                <div class="mb-4">

                    <h2 class="h6">
                      @if (Model.RequestType == ContributionRequestTypes.ReadingLink)
                      {
                           <span>@Localizer["Link Description"]</span>
                      }
                      else if (Model.RequestType == ContributionRequestTypes.BookInformation)
                      {
                           <span>@Localizer["Information Suggested"]</span>
                      }
                      else if (Model.RequestType == ContributionRequestTypes.NewBook)
                      {
                          <span>@Localizer["Book Suggestion"]</span>
                      }
                      else if (Model.RequestType == ContributionRequestTypes.AdminRequest)
                      {
                         <span>@Localizer["Moderator Application"]</span>
                      }
                      else
                      {
                         <span>@Localizer["Suggestion"]</span>
                      }
                    </h2>

                    <div class="bg-light rounded-4 p-3">
                       @Model.Message
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.AdditionalInformation))
                {
                    <div class="mb-4">

                        <h2 class="h6">
                            @Localizer["Additional Information"]
                        </h2>

                        <div class="bg-light rounded-4 p-3">
                            @Model.AdditionalInformation
                        </div>

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
                {
                    <div class="mb-4">

                        <h2 class="h6">
                            @Localizer["Source"]
                        </h2>

                        <a href="@Model.SourceUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            @Model.SourceUrl
                        </a>

                    </div>
                }


                @if (Model.RequestType == ContributionRequestTypes.ReadingLink)
                {
                    <div class="mb-4">

                        <h2 class="h6">
                            @Localizer["Reading Link Details"]
                        </h2>

                        <dl class="row">

                            <dt class="col-sm-4">
                                @Localizer["Website"]
                            </dt>

                            <dd class="col-sm-8">
                                @Model.WebsiteName
                            </dd>

                            <dt class="col-sm-4">
                                @Localizer["Language"]
                            </dt>

                            <dd class="col-sm-8">
                                @Model.Language
                            </dd>

                            <dt class="col-sm-4">
                                @Localizer["Link Type"]
                            </dt>

                            <dd class="col-sm-8">
                                @Model.LinkType
                            </dd>

                        </dl>

                    </div>
                }


                @if (Model.Status == ContributionRequestStatuses.Pending)
                {
                    <div class="d-flex gap-2">

                        <form asp-action="ApproveContributionRequest"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-success">
                                @Localizer["Approve"]
                            </button>

                        </form>


                        <form asp-action="RejectContributionRequest"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger">
                                @Localizer["Reject"]
                            </button>

                        </form>

                    </div>
                }


               <div class="d-flex gap-2">

                  @if (Model.Status == ContributionRequestStatuses.Approved)
                  {
                      <form asp-action="ResolveContributionRequest"
                            asp-route-id="@Model.Id"
                            method="post">

                         @Html.AntiForgeryToken()

                         <button type="submit"
                             class="btn btn-primary">
                             @Localizer["Mark as Resolved"]
                         </button>

                      </form>
                  }

                  @if (Model.Status != ContributionRequestStatuses.Pending)
                  {
                       <form asp-action="DeleteContributionRequest"
                             asp-route-id="@Model.Id"
                             method="post"
                             onsubmit="return confirm('@Localizer["Are you sure you want to delete this request?"]');">

                             @Html.AntiForgeryToken()

                          <button type="submit"
                                  class="btn btn-outline-danger">
                               @Localizer["Delete Request"]
                          </button>

                       </form>
                  }

               </div>
                

                <div class="mt-4">

                    <a asp-action="ContributionRequests"
                       class="btn btn-outline-secondary">
                        @Localizer["Back to Requests"]
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
