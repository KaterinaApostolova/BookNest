@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model List<BookNest.ViewModels.BookRecommendation>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var rec in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@rec.Book.Id" class="text-decoration-none text-dark">@rec.Book.Title</a>
                        </h5>
                        <p class="text-muted small mb-2">@Localizer["By"] @string.Join(", ", rec.Book.Authors.Select(a => a.Name))</p>
                        <p class="card-text small fst-italic flex-grow-1">"@rec.Reason"</p>
                        <a class="btn btn-outline-primary btn-sm align-self-start" asp-controller="Books" asp-action="Details" asp-route-id="@rec.Book.Id">@Localizer["Open Details"]</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted mb-0">@Localizer["Rate a few books or set your favourite genre in your profile, and Lyra will start picking recommendations for you here."]</p>
}
