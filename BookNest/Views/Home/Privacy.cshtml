@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Privacy"];
}

<div class="card shadow-sm rounded-4 p-4">
    <h1 class="h3 mb-3">@Localizer["Privacy"]</h1>
    <p class="text-muted">@Localizer["BookNest keeps your reading journey personal and safe. We use your information only to improve the experience and support community features."]</p>
</div>
