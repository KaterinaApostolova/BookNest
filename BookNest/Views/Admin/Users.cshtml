@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model List<BookNest.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = Localizer["Manage Users"];
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                @Localizer["Manage Users"]
            </h1>

            <p class="text-muted mb-0">
                @Localizer["View and manage BookNest users."]
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            @Localizer["Back to Dashboard"]
        </a>

    </div>


    <!-- SEARCH -->

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">

        <form asp-action="Users"
              method="get">

            <div class="row g-2">

                <div class="col-md-10">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="@Localizer["Search by username, name or email..."]" />

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        @Localizer["Search"]
                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- USERS TABLE -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    @Localizer["Username"]
                                </th>

                                <th>
                                    @Localizer["Full Name"]
                                </th>

                                <th>
                                    @Localizer["Email"]
                                </th>

                                <th>
                                    @Localizer["Status"]
                                </th>

                                <th>
                                    @Localizer["Role"]
                                </th>

                                <th class="text-end pe-4">
                                    @Localizer["Action"]
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var user in Model)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <strong>
                                            @user.UserName
                                        </strong>
                                    </td>


                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(user.FullName))
                                        {
                                            @user.FullName
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                &mdash;
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        @user.Email
                                    </td>


                                    <td>

                                        @if (user.IsDeactivated)
                                        {
                                            <span class="badge bg-danger">
                                                @Localizer["Deactivated"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                @Localizer["Active"]
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (user.IsAdmin)
                                        {
                                            <span class="badge bg-dark">
                                                @Localizer["Admin"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">
                                                @Localizer["User"]
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end pe-4">

                                        <a asp-action="UserDetails"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            @Localizer["Details"]

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <h2 class="h5">
                        @Localizer["No users found"]
                    </h2>

                    <p class="text-muted mb-0">
                        @Localizer["Try a different search."]
                    </p>

                </div>
            }

        </div>

    </div>

</div>
