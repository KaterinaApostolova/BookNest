@{
    ViewData["Title"] = "Admin Panel";
}

<div class="row g-4">

    <!-- Books -->
    <div class="col-md-6">
        <div class="card shadow-sm rounded-4 p-4 h-100">

            <h2 class="h4">Manage Books</h2>

            <p class="text-muted">
                Create, edit, and remove books from the catalog.
            </p>

            <a class="btn btn-primary"
               asp-controller="Books"
               asp-action="Create">
                Create Book
            </a>

            <a class="btn btn-outline-secondary ms-2"
               asp-controller="Books"
               asp-action="Index">
                View Books
            </a>

        </div>
    </div>


    <!-- Moderation -->
    <div class="col-md-6">
      <div class="card shadow-sm rounded-4 p-4 h-100">

        <h2 class="h4">Moderation</h2>

        <p class="text-muted">
            Review user suggestions, reading link requests,
            book information, new book suggestions and
            moderator applications.
        </p>

        <a asp-controller="Moderation"
           asp-action="ContributionRequests"
           class="btn btn-primary">
            Manage Requests
        </a>

    </div>
</div>

    <!-- Users -->
    <div class="col-md-6">

    <div class="card shadow-sm rounded-4 p-4 h-100">

        <h2 class="h4 mb-2">
            Users
        </h2>

        <p class="text-muted">
            There are
            <strong>@ViewBag.UsersCount</strong>
            registered users in the system.
        </p>

        <a asp-controller="Admin"
           asp-action="Users"
           class="btn btn-primary">

            Manage Users

        </a>

    </div>

</div>