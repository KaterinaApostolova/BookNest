@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Admin Panel"];
}

<div class="row g-4">

    <!-- Books -->
    <div class="col-md-6">
        <div class="card shadow-sm rounded-4 p-4 h-100">

            <h2 class="h4">@Localizer["Manage Books"]</h2>

            <p class="text-muted">
                @Localizer["Create, edit, and remove books from the catalog."]
            </p>

            <a class="btn btn-primary"
               asp-controller="Books"
               asp-action="Create">
                @Localizer["Create Book"]
            </a>

            <a class="btn btn-outline-secondary ms-2"
               asp-controller="Books"
               asp-action="Index">
                @Localizer["View Books"]
            </a>

        </div>
    </div>


    <!-- Moderation -->
    <div class="col-md-6">
      <div class="card shadow-sm rounded-4 p-4 h-100">

        <h2 class="h4">@Localizer["Moderation"]</h2>

        <p class="text-muted">
            @Localizer["Review user suggestions, reading link requests, book information, new book suggestions and moderator applications."]
        </p>

        <a asp-controller="Moderation"
           asp-action="ContributionRequests"
           class="btn btn-primary">
            @Localizer["Manage Requests"]
        </a>

    </div>
</div>

    <!-- Users -->
    <div class="col-md-6">

    <div class="card shadow-sm rounded-4 p-4 h-100">

        <h2 class="h4 mb-2">
            @Localizer["Users"]
        </h2>

        <p class="text-muted">
            @Localizer["There are"]
            <strong>@ViewBag.UsersCount</strong>
            @Localizer["registered users in the system."]
        </p>

        <a asp-controller="Admin"
           asp-action="Users"
           class="btn btn-primary">

            @Localizer["Manage Users"]

        </a>

    </div>

</div>
