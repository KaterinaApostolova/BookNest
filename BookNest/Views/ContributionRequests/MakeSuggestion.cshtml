@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.ViewModels.ContributionRequestViewModel

@{
    ViewData["Title"] = Localizer["Make a Suggestion"];
}

<div class="container mt-5">
    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <h1 class="h4 mb-2">
                    @Localizer["Make a Suggestion"]
                </h1>

                <p class="text-muted mb-4">
                    @Localizer["Help us improve BookNest by sharing an idea, suggesting a book, providing additional information, or requesting moderator access."]
                </p>

                <form asp-action="CreateContributionRequest"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-4">

                        <label asp-for="RequestType"
                               class="form-label">
                            @Localizer["What would you like to suggest?"]
                        <span class="text-danger">*</span>
                        </label> 

                        <select asp-for="RequestType"
                                class="form-select">

                            <option value="@ContributionRequestTypes.NewBook">
                                @Localizer["Suggest a New Book"]
                            </option>

                            <option value="@ContributionRequestTypes.GeneralSuggestion">
                                @Localizer["General Suggestion/Feedback"]
                            </option>

                            <option value="@ContributionRequestTypes.AdminRequest">
                                @Localizer["Request Moderator Access"]
                            </option>

                        </select>

                        <span asp-validation-for="RequestType"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="Message"
                               class="form-label">
                            @Localizer["Your suggestion"]
                        <span class="text-danger">*</span>
                        </label> 

                        <textarea asp-for="Message"
                                  class="form-control"
                                  rows="7"
                                  placeholder="@Localizer["Describe your suggestion..."]"></textarea>

                        <span asp-validation-for="Message"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="AdditionalInformation"
                               class="form-label">
                            @Localizer["Additional Information"]
                        </label>

                        <textarea asp-for="AdditionalInformation"
                                  class="form-control"
                                  rows="4"
                                  placeholder="@Localizer["Optional additional information..."]"></textarea>

                        <span asp-validation-for="AdditionalInformation"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="SourceUrl"
                               class="form-label">
                            @Localizer["Source / Link"]
                        </label>

                        <input asp-for="SourceUrl"
                               class="form-control"
                               placeholder="https://... (@Localizer["optional"])" />

                        <span asp-validation-for="SourceUrl"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            @Localizer["Send Suggestion"]
                        </button>

                        <a asp-controller="Profile"
                           asp-action="Profile"
                           class="btn btn-outline-secondary">
                            @Localizer["Cancel"]
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
