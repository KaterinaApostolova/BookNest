@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.ViewModels.ContributionRequestViewModel

@{
    ViewData["Title"] = Localizer["Make a Suggestion"];

    var title = Model.RequestType switch
    {
        "ReadingLink" => Localizer["Suggest a Reading Link"],
        "BookInformation" => Localizer["Suggest Book Information"],
        "NewBook" => Localizer["Suggest a New Book"],
        "GeneralSuggestion" => Localizer["Send a Suggestion"],
        "AdminRequest" => Localizer["Request Moderator Access"],
        _ => Localizer["Make a Suggestion"]
    };
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <h2 class="h4 mb-2">
                    @title
                </h2>

                @if (!string.IsNullOrWhiteSpace(Model.BookTitle))
                {
                    <p class="text-muted mb-4">
                        @Localizer["Book:"]
                        <strong>@Model.BookTitle</strong>
                    </p>
                }

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <form asp-action="CreateContributionRequest"
                      method="post">

                    <input asp-for="BookId" type="hidden" />
                    <input asp-for="RequestType" type="hidden" />

                    @if (Model.RequestType == ContributionRequestTypes.ReadingLink)
                    {
                        <div class="mb-3">
                            <label asp-for="WebsiteName"
                                   class="form-label">
                                @Localizer["Website"]
                            </label>
                            <span class="text-danger">*</span>
                            <input asp-for="WebsiteName"
                                   class="form-control"
                                   placeholder="For example: Chitanka" />

                            <span asp-validation-for="WebsiteName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Language"
                                   class="form-label">
                                @Localizer["Language"]
                            </label>
                            <span class="text-danger">*</span>
                            <input asp-for="Language"
                                   class="form-control"
                                   placeholder="For example: Bulgarian" />

                            <span asp-validation-for="Language"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SourceUrl"
                                   class="form-label">
                                @Localizer["Reading Link"]
                            </label>
                             <span class="text-danger">*</span>
                            <input asp-for="SourceUrl"
                                   class="form-control"
                                   placeholder="https://..." />

                            <span asp-validation-for="SourceUrl"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LinkType"
                                   class="form-label">
                                @Localizer["Link Type"]
                            </label>
                            <span class="text-danger">*</span>
                            <select asp-for="LinkType"
                                    class="form-select">

                                <option value="">@Localizer["Select type"]</option>
                                <option value="Read Online">@Localizer["Read Online"]</option>
                                <option value="Borrow">@Localizer["Borrow"]</option>
                                <option value="Buy">@Localizer["Buy"]</option>
                                <option value="Other">@Localizer["Other"]</option>

                            </select>

                            <span asp-validation-for="LinkType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Message"
                                   class="form-label">
                                @Localizer["Additional Information"]
                            </label>
                            <span class="text-danger">*</span>
                            <textarea asp-for="Message"
                                      class="form-control"
                                      rows="4"
                                      placeholder="@Localizer["Tell us anything useful about this reading link..."]"></textarea>

                            <span asp-validation-for="Message"
                                  class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="Message"
                                   class="form-label">
                                @if (Model.RequestType == ContributionRequestTypes.AdminRequest)
                                {
                                    <span>@Localizer["Why would you like to become a moderator?"]</span>
                                }
                                else if (Model.RequestType == ContributionRequestTypes.NewBook)
                                {
                                    <span>@Localizer["Which book would you like to suggest?"]</span>
                                }
                                else
                                {
                                    <span>@Localizer["What would you like to suggest?"]</span>
                                }

                                <span class="text-danger">*</span>
                            </label>

                            <textarea asp-for="Message"
                                      class="form-control"
                                      rows="6"
                                      placeholder="@Localizer["Tell us your suggestion..."]"></textarea>

                            <span asp-validation-for="Message"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AdditionalInformation"
                                   class="form-label">
                                @Localizer["Additional Information"]
                            </label>

                            <textarea asp-for="AdditionalInformation"
                                      class="form-control"
                                      rows="4"
                                      placeholder="@Localizer["Add any additional details that may help the moderators..."]"></textarea>

                            <span asp-validation-for="AdditionalInformation"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SourceUrl"
                                   class="form-label">
                                @Localizer["Source / Link"]
                            </label>

                            <input asp-for="SourceUrl"
                                   class="form-control"
                                   placeholder="https://... (@Localizer["optional"])" />

                            <span asp-validation-for="SourceUrl"
                                  class="text-danger"></span>

                            <div class="form-text">
                                @Localizer["Optional. Add a source if you have one."]
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-primary">
                            @Localizer["Send"]
                        </button>

                        @if (Model.BookId.HasValue)
                        {
                            <a asp-controller="Books"
                               asp-action="Details"
                               asp-route-id="@Model.BookId"
                               class="btn btn-secondary">
                                @Localizer["Cancel"]
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Profile"
                               asp-action="Profile"
                               class="btn btn-secondary">
                                @Localizer["Cancel"]
                            </a>
                        }

                    </div>

                </form>

            </div>

        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
