@model IEnumerable<BookNest.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Books</h2>
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <a class="btn btn-primary" asp-action="Create">Create Book</a>
    }
</div>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label">Search by title or author</label>
        <input name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search books" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Filter by genre</label>
        <select name="genreId" class="form-select">
            <option value="">All genres</option>
            @foreach (var genre in (IEnumerable<BookNest.Models.Genre>)ViewBag.Genres)
            {
                <option value="@genre.Id" selected="@(genre.Id == (int?)ViewBag.GenreId)">@genre.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Sort</label>
        <select name="sortOrder" class="form-select">
            <option value="asc" selected="@(ViewBag.SortOrder == "asc")">A-Z</option>
            <option value="z-a" selected="@(ViewBag.SortOrder == "z-a")">Z-A</option>
            <option value="highest-rated" selected="@(ViewBag.SortOrder == "highest-rated")">Highest Rated</option>
            <option value="newest-first" selected="@(ViewBag.SortOrder == "newest-first")">Newest First</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Apply</button>
    </div>
</form>

<div class="row g-4">
    @foreach (var book in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 position-relative">
                <img src="@(string.IsNullOrWhiteSpace(book.CoverImageUrl) ? "/images/books/cover-placeholder.svg" : book.CoverImageUrl)" class="card-img-top rounded-top-4" alt="@book.Title" onerror="this.src='/images/books/cover-placeholder.svg'" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@book.Title</h5>
                    <p class="text-muted mb-2">By @string.Join(", ", book.Authors.Select(a => a.Name))</p>
                    <p class="small text-secondary mb-1">Genre: @string.Join(", ", book.Genres.Select(g => g.Name))</p>
                    <p class="small text-secondary mb-3">Publication Year: @(book.PublicationYear?.ToString() ?? "N/A")</p>
                    <p class="card-text">@(string.IsNullOrWhiteSpace(book.Description) ? "No description available yet." : book.Description)</p>
                    <div class="mt-auto d-flex gap-2">
                        <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@book.Id">Open Details</a>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                        }
                    </div>
                </div>
            </div>
                
        </div>
    }
</div>
