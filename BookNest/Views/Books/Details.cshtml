@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="row g-4">
    <div class="col-lg-4">
        <img src="@(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "/images/books/cover-placeholder.svg" : Model.CoverImageUrl)" alt="@Model.Title" class="img-fluid rounded-4 shadow-sm" onerror="this.src='/images/books/cover-placeholder.svg'" />
    </div>
    <div class="col-lg-8">
        <h2 class="mb-3">@Model.Title</h2>
        <p class="text-muted mb-3">@Localizer["By"] @string.Join(", ", Model.Authors.Select(a => a.Name))</p>
        <p><strong>@Localizer["Genres:"]</strong> @string.Join(", ", Model.Genres.Select(g => BookNest.Services.GenreTranslator.Localize(g.Name)))</p>
        <p><strong>@Localizer["Publication Year:"]</strong> @(Model.PublicationYear?.ToString() ?? Localizer["Not available"].Value)</p>
        <p><strong>@Localizer["Average Rating:"]</strong> @(Model.AverageRating?.ToString("0.0") ?? Localizer["Not rated yet"].Value)</p>
        <p><strong>@Localizer["Community Rating:"]</strong> @(Model.Reviews.Any() ? $"{Model.Reviews.Count()} {Localizer["reviews"].Value}" : Localizer["No community rating yet"].Value)</p>
        <p class="lead book-description" data-book-id="@Model.Id" data-original-text="@Model.Description">@(string.IsNullOrWhiteSpace(Model.Description) ? Localizer["No description available yet."].Value : Model.Description)</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <button type="button" class="btn btn-link btn-sm p-0 mb-3 translate-description-btn">@Localizer["Translate"]</button>
        }

        <div class="mt-4 d-flex gap-2 flex-wrap">
           @if (User.Identity?.IsAuthenticated == true)
{
           <form asp-controller="ReadingJourney" asp-action="AddToReadingJourney" method="post">
             <input type="hidden" name="bookId" value="@Model.Id" />

                <button type="submit" class="btn btn-primary mt-2">
                  @Localizer["Add to Reading Journey"]
                </button>
           </form>
           }
          else
          {
             <a class="btn btn-primary"
               asp-controller="Account"
               asp-action="Login">
               @Localizer["Login to add to Reading Journey"]
             </a>
          }
        </div>

        <div class="mt-3">
            <a asp-controller="Community" asp-action="BookDiscussion" asp-route-bookId="@Model.Id" class="btn btn-outline-primary">
                @Localizer["Book Discussion"]
            </a>
            <a asp-controller="Lyra" asp-action="Index" asp-route-bookId="@Model.Id" class="btn btn-outline-primary">
                @Localizer["Ask Lyra about this book"]
            </a>
        </div>

      <div class="mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">@Localizer["Reading Links"]</h4>

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <a asp-controller="ReadingLinks" 
               asp-action="AddReadingLink" 
               asp-route-bookId="@Model.Id" 
               class="btn btn-primary btn-sm">
                @Localizer["Add Reading Link"]
            </a>
        }
    </div>

    @if (Model.ReadingLinks.Any())
    {
        var groupedLinks = Model.ReadingLinks
            .GroupBy(link => link.Language)
            .OrderBy(group => group.Key);

        @foreach (var group in groupedLinks)
        {
            <div class="mb-3">

                <h5 class="h6">@group.Key</h5>

                <ul class="list-group">

                    @foreach (var link in group)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">

                            <div>
                                <div class="fw-bold">
                                    @link.WebsiteName
                                </div>

                                <div class="text-muted small">
                                    @link.LinkType
                                </div>
                            </div>

                            <div class="d-flex gap-2">

                                <a class="btn btn-outline-primary btn-sm"
                                   href="@link.Url"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    @Localizer["Open"]
                                </a>

                                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                                {
                                    <a asp-controller="ReadingLinks" 
                                       asp-action="EditReadingLink"
                                       asp-route-id="@link.Id"
                                       class="btn btn-outline-secondary btn-sm">
                                        @Localizer["Edit"]
                                    </a>

                                    <form asp-controller="ReadingLinks"
                                          asp-action="DeleteReadingLink"
                                          asp-route-id="@link.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('@Localizer["Delete this reading link?"]');">
                                            @Localizer["Delete"]
                                        </button>

                                    </form>
                                }

                            </div>

                        </li>
                    }

                </ul>

            </div>
        }
    }
    else
    {
        <p class="text-muted">
            @Localizer["No reading links are available yet."]
        </p>

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <p class="text-muted small">
                @Localizer["Add the first reading link for this book."]
            </p>
        }
    }


     <!-- Suggestions -->
@if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
{
    <div class="mt-4 d-flex flex-wrap gap-2">

        <a asp-controller="ContributionRequests"
           asp-action="CreateContributionRequest"
           asp-route-id="@Model.Id"
           asp-route-type="@ContributionRequestTypes.ReadingLink"
           class="btn btn-outline-primary">
            @Localizer["Suggest a Reading Link"]
        </a>

        <a asp-controller="ContributionRequests"
           asp-action="CreateContributionRequest"
           asp-route-id="@Model.Id"
           asp-route-type="@ContributionRequestTypes.BookInformation"
           class="btn btn-outline-secondary">
            @Localizer["Suggest Book Information"]
        </a>

    </div>
}
else if (User.Identity?.IsAuthenticated != true)
{
    <div class="mt-4">

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-outline-primary">
            @Localizer["Login to Make a Suggestion"]
        </a>

    </div>
}

      </div>
  </div> 

</div>

<section class="mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="h4 mb-1">@Localizer["Reviews"]</h2>

            <p class="text-muted mb-0">
                @Localizer["See what other readers think about this book."]
            </p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            var hasReviewed = Model.Reviews
                .Any(r => r.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);

            if (!hasReviewed)
            {
                <a asp-controller="Reviews"
                   asp-action="Create"
                   asp-route-bookId="@Model.Id"
                   class="btn btn-primary">
                    @Localizer["Write a Review"]
                </a>
            }
        }
        else
        {
            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-outline-primary">
                @Localizer["Login to Review"]
            </a>
        }

    </div>

    @if (Model.Reviews.Any())
    {
        foreach (var review in Model.Reviews
            .OrderByDescending(r => r.CreatedAt))
        {
            <div class="card border-0 shadow-sm rounded-4 mb-3">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <span class="fw-semibold">
                                <partial name="_AuthorDisplay" model="@(new BookNest.ViewModels.AuthorDisplayViewModel { UserName = review.User != null ? review.User.UserName : null, AvatarUrl = review.User?.ProfilePictureUrl, IsProfilePublic = review.User != null && review.User.IsProfilePublic, IsAnonymous = review.IsAnonymous, FallbackLabel = Localizer["Anonymous Reader"].Value, AnonymousLabel = Localizer["Anonymous Reader"].Value })" />
                            </span>

                            <div class="small text-muted">
                                @review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>

                        <div class="review-rating">
                            @for (var i = 0; i < review.Rating; i++)
                            {
                                <span class="review-star">&#9733;</span>
                            }
                        </div>

                    </div>

                    <p class="mt-3 mb-3 review-content" data-review-id="@review.Id" data-original-text="@review.Content">
                        @review.Content
                    </p>

                    <button type="button"
                            class="btn btn-link btn-sm p-0 mb-3 translate-review-btn"
                            data-review-id="@review.Id">
                        @Localizer["Translate"]
                    </button>

                    @{
                        var currentUserId =
                            User.FindFirst(
                                System.Security.Claims.ClaimTypes.NameIdentifier
                            )?.Value;

                        var isOwner =
                            User.Identity?.IsAuthenticated == true &&
                            review.UserId == currentUserId;

                        var isAdmin =
                            User.Identity?.IsAuthenticated == true &&
                            User.IsInRole("Admin");
                    }

                    @if (isOwner || isAdmin)
                    {
                        <div class="d-flex gap-2">

                            @if (isOwner)
                            {
                                <a asp-controller="Reviews"
                                   asp-action="Edit"
                                   asp-route-id="@review.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    @Localizer["Edit"]
                                </a>
                            }

                            <a asp-controller="Reviews"
                               asp-action="Delete"
                               asp-route-id="@review.Id"
                               class="btn btn-outline-danger btn-sm">
                                @Localizer["Delete"]
                            </a>

                        </div>
                    }

                </div>

            </div>
        }
    }
    else
    {
        <div class="text-center py-4">

            <p class="text-muted mb-3">
                @Localizer["No reviews yet."]
            </p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Reviews"
                   asp-action="Create"
                   asp-route-bookId="@Model.Id"
                   class="btn btn-outline-primary">
                    @Localizer["Be the first to review this book"]
                </a>
            }

        </div>
    }

</section>

@if (ViewBag.SimilarBooks is IEnumerable<BookNest.Models.Book> similarBooks && similarBooks.Any())
{
    <div class="mt-5">
        <h3 class="h4 mb-3">@Localizer["You may also like"]</h3>
        <div class="row g-4">
            @foreach (var similarBook in similarBooks)
            {
                <div class="col-md-6 col-lg-3">
                    <a class="card h-100 border-0 shadow-sm rounded-4 text-decoration-none text-dark" asp-action="Details" asp-route-id="@similarBook.Id">
                        <div class="card-body">
                            <h5 class="card-title">@similarBook.Title</h5>
                            <p class="text-muted mb-2">@Localizer["By"] @string.Join(", ", similarBook.Authors.Select(a => a.Name))</p>
                            <p class="small text-secondary">@string.Join(", ", similarBook.Genres.Select(g => BookNest.Services.GenreTranslator.Localize(g.Name)))</p>
                            <span class="btn btn-outline-primary btn-sm">@Localizer["Open Details"]</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.translate-review-btn').forEach(function (button) {
            button.addEventListener('click', async function () {
                const reviewId = button.dataset.reviewId;
                const paragraph = document.querySelector('.review-content[data-review-id="' + reviewId + '"]');
                const targetLanguage = document.documentElement.lang === 'bg' ? 'bg' : 'en';
                const originalText = paragraph.dataset.originalText;

                if (button.dataset.translated === 'true') {
                    paragraph.textContent = originalText;
                    button.textContent = '@Localizer["Translate"]';
                    button.dataset.translated = 'false';
                    return;
                }

                button.disabled = true;
                const previousLabel = button.textContent;
                button.textContent = '@Localizer["Translating..."]';

                try {
                    const response = await fetch('/Reviews/Translate/' + reviewId + '?targetLanguage=' + targetLanguage, {
                        method: 'GET'
                    });

                    if (!response.ok) {
                        throw new Error('Translation failed');
                    }

                    const data = await response.json();
                    paragraph.textContent = data.translated;
                    button.textContent = '@Localizer["Show original"]';
                    button.dataset.translated = 'true';
                } catch (error) {
                    button.textContent = '@Localizer["Translation unavailable — try again"]';
                } finally {
                    button.disabled = false;
                }
            });
        });

        var descTranslateBtn = document.querySelector('.translate-description-btn');
        if (descTranslateBtn) {
            descTranslateBtn.addEventListener('click', async function () {
                var paragraph = document.querySelector('.book-description');
                var bookId = paragraph.dataset.bookId;
                var targetLanguage = document.documentElement.lang === 'bg' ? 'bg' : 'en';
                var originalText = paragraph.dataset.originalText;

                if (descTranslateBtn.dataset.translated === 'true') {
                    paragraph.textContent = originalText;
                    descTranslateBtn.textContent = '@Localizer["Translate"]';
                    descTranslateBtn.dataset.translated = 'false';
                    return;
                }

                descTranslateBtn.disabled = true;
                var previousLabel = descTranslateBtn.textContent;
                descTranslateBtn.textContent = '@Localizer["Translating..."]';

                try {
                    var response = await fetch('/Books/TranslateDescription/' + bookId + '?targetLanguage=' + targetLanguage, {
                        method: 'GET'
                    });

                    if (!response.ok) {
                        throw new Error('Translation failed');
                    }

                    var data = await response.json();
                    paragraph.textContent = data.translated;
                    descTranslateBtn.textContent = '@Localizer["Show original"]';
                    descTranslateBtn.dataset.translated = 'true';
                } catch (error) {
                    descTranslateBtn.textContent = '@Localizer["Translation unavailable — try again"]';
                } finally {
                    descTranslateBtn.disabled = false;
                }
            });
        }
    </script>
}
