@model BookNest.ViewModels.ReviewViewModel

@{
    ViewData["Title"] = "Write a Review";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <h2 class="h4 mb-2">Write a Review</h2>

                <p class="text-muted mb-4">
                    Book:
                    <strong>@Model.BookTitle</strong>
                </p>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <form asp-action="Create" method="post">

                    <input asp-for="BookId" type="hidden" />

                     <div class="mb-4">
                        <label asp-for="Rating" class="form-label fw-semibold">
                          Rating
                        </label>

                        <div class="rating-stars" role="radiogroup" aria-label="Book rating">

                          @for (int i = 1; i <= 5; i++)
                          {
                             <input type="radio"
                                    asp-for="Rating"
                                    value="@i"
                                    id="rating-@i"
                                    class="rating-input" />

                             <label for="rating-@i"
                                    class="rating-star"
                                    title="@i out of 5">
                                    &#9733;
                             </label>
                          }

                        </div>

                       <span asp-validation-for="Rating" class="text-danger"></span>
                     </div>

                    <div class="mb-4">
                        <label asp-for="Content"
                               class="form-label fw-semibold">
                            Your Review
                        </label>

                        <textarea asp-for="Content"
                                  class="form-control"
                                  rows="7"
                                  placeholder="What did you think about this book?"></textarea>

                        <span asp-validation-for="Content"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Publish Review
                        </button>

                        <a asp-controller="Books"
                           asp-action="Details"
                           asp-route-id="@Model.BookId"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const ratingInputs = document.querySelectorAll('.rating-input');
        const ratingStars = document.querySelectorAll('.rating-star');

        ratingInputs.forEach((input, index) => {
            input.addEventListener('change', function () {
                ratingStars.forEach((star, starIndex) => {
                    if (starIndex <= index) {
                        star.classList.add('selected');
                    } else {
                        star.classList.remove('selected');
                    }
                });
            });
        });
    </script>
}