@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.ViewModels.ReviewViewModel

@{
    ViewData["Title"] = Localizer["Delete Review"];
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4 p-4">

                <h2 class="h4 mb-3">@Localizer["Delete Review"]</h2>

                <p class="text-muted">
                    @Localizer["Are you sure you want to delete this review?"]
                </p>

                <div class="border rounded-4 p-3 mb-4">

                    <div class="mb-2">
                        <strong>@Model.BookTitle</strong>
                    </div>

                    <div class="mb-2">
                        @Localizer["Rating:"]
                        @for (var i = 0; i < Model.Rating; i++)
                        {
                            <span>?</span>
                        }
                    </div>

                    <p class="mb-0 text-muted">
                        @Model.Content
                    </p>

                </div>

                <form asp-action="DeleteConfirmed"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    @Html.AntiForgeryToken()

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-danger">
                            @Localizer["Delete Review"]
                        </button>

                        <a asp-controller="Books"
                           asp-action="Details"
                           asp-route-id="@Model.BookId"
                           class="btn btn-secondary">
                            @Localizer["Cancel"]
                        </a>

                    </div>

                </form>

            </div>

        </div>
    </div>
</div>
