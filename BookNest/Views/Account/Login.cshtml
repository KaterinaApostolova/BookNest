@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model BookNest.ViewModels.LoginViewModel

@{
    ViewData["Title"] = Localizer["Login"];
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <img src="~/images/logo.png"
                     alt="BookNest logo"
                     class="welcome-logo" />

                <h2 class="h4 mb-3">@Localizer["Welcome back"]</h2>

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label">
                            @Localizer["Username or Email"]
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="UsernameOrEmail"
                               class="form-control" />

                        <span asp-validation-for="UsernameOrEmail"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            @Localizer["Password"]
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <label asp-for="RememberMe"
                               class="form-check-label">
                            @Localizer["Remember me"]
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        @Localizer["Login"]
                    </button>
                </form>

                <div class="mt-3 text-center">
                    <a asp-action="ForgotPassword">
                        @Localizer["Forgot password?"]
                    </a>

                    <span class="mx-2">|</span>

                    <a asp-action="Register">
                        @Localizer["Create an account"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
