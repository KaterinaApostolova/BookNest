@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Access Denied"];
}

<div class="card shadow-sm rounded-4 p-4 text-center">
    <h2 class="h4 mb-3">@Localizer["Access denied"]</h2>
    <p class="text-muted">@Localizer["You do not have permission to view this page."]</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@Localizer["Return Home"]</a>
</div>
